# Firebase client configuration.
# These values identify the project and are safe to ship in a browser bundle.
# They do NOT protect your data. Firestore/Storage security rules do.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: local Firebase emulator suite (npm run emulators)
VITE_USE_FIREBASE_EMULATORS=false
VITE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_STORAGE_EMULATOR_PORT=9199

# Trusted operations are served by Netlify Functions at the same origin.
# Leave this unset in production. For local frontend development against a
# separately running Netlify Functions server, set the full function base URL.
# VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:8888/.netlify/functions
