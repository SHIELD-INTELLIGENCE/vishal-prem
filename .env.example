# Firebase client configuration.
# These values identify the project and are safe to ship in a browser bundle.
# They do NOT protect your data. Firestore/Storage security rules do.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: local Firebase emulator suite (npm run emulators)
VITE_USE_FIREBASE_EMULATORS=false
VITE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_STORAGE_EMULATOR_PORT=9199

# Trusted operations are served by Netlify Functions at the same origin.
# Leave this unset in production. `npm run dev` (Netlify Dev) serves the SPA and
# the real `/.netlify/functions/*` routes on http://localhost:8888, so no base
# URL is needed. `npm run dev:vite` is SPA-only and trusted writes will 404.
# VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:8888/.netlify/functions

# ---------------------------------------------------------------------------
# Server-only Firebase Admin credentials for local Netlify Functions.
#
# NEVER prefix these with VITE_ and NEVER commit a real service-account key.
# In production, store them in the Netlify Functions environment (or Firebase
# Functions secrets for the legacy callables), not in this file. For local
# development, export them in the shell or put them in `.env.local` (Netlify
# Dev loads it; Vite only exposes `VITE_*` values to the browser).
#
# Either provide the three fields below...
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# ...or provide the complete service-account JSON as one value.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Comma-separated browser origins allowed to call the Netlify Functions
# directly. Netlify Dev proxies same-origin requests, so this is only needed
# when VITE_FUNCTIONS_BASE_URL points at a different origin.
# ALLOWED_APP_ORIGINS=http://localhost:5173,http://localhost:8888

# ---------------------------------------------------------------------------
# Server-only emulator routing for Netlify Functions. These are not VITE_
# variables. Set GCLOUD_PROJECT to the same project id as the emulator and the
# browser client (VITE_FIREBASE_PROJECT_ID).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=your-project
