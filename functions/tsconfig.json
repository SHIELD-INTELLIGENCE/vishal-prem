{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "rootDir": "..",
    "outDir": "lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../src/types/models.ts",
    "../src/lib/calculations.ts",
    "../src/lib/domainErrors.ts",
    "../src/lib/orderOperations.ts",
    "../src/lib/paymentOperations.ts",
    "../src/lib/stockOperations.ts",
    "../src/lib/validation.ts",
    "../src/auth/permissions.ts"
  ]
}
