rules_version = '2';

// Product photography is publicly readable so any client can render it.
// Writes are restricted to active staff who can manage products for the outlet
// encoded in the upload path.
service firebase.storage {
  match /b/{bucket}/o {

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function canWriteProducts(outletId) {
      return request.auth != null
        && profile().active == true
        && (
          profile().role == 'super_admin'
          || (
            profile().permissions.productsManage == true
            && outletId in profile().outletIds
          )
        );
    }

    match /product-images/{outletId}/{fileName} {
      allow read: if true;
      allow write: if canWriteProducts(outletId)
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canWriteProducts(outletId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
